# ============================================================
# AGR.BIZ.ID — Variabel environment (salin ke .env lalu isi)
# Arsitektur: Frontend statis InfinityFree + DB Supabase + Media Cloudinary
# ============================================================

# ---- DATABASE: Supabase Postgres ----
# Dashboard Supabase → Project Settings → Database → Connection string (URI)
# Gunakan koneksi "Direct connection" (port 5432) untuk SQLAlchemy.
SUPABASE_DB_URL=postgresql://postgres.<REF>:<PASSWORD>@db.<REF>.supabase.co:5432/postgres?sslmode=require
# atau format terpisah:
#DB_HOST=db.xxxx.supabase.co
#DB_PORT=5432
#DB_USER=postgres
#DB_PASSWORD=xxxx
#DB_NAME=postgres

# ---- MEDIA: Cloudinary (cloudinary.com) ----
# Pemasok file multimedia: foto produk, avatar, eviden, dokumen.
# Upload langsung browser -> Cloudinary (unsigned preset utk mode statis),
# otomatis kompresi + WebP/AVIF (f_auto,q_auto) + thumbnail via CDN.
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_UPLOAD_PRESET=agr_unsigned

# ---- Object Storage S3-compatible (alternatif MinIO/DigitalOcean Spaces) ----
AGR_S3_ENDPOINT_URL=
AGR_S3_REGION=ap-southeast-1
AGR_S3_ACCESS_KEY=
AGR_S3_SECRET_KEY=
AGR_BUCKET_PUBLIC=agrid-media-public
AGR_BUCKET_PRIVATE=agrid-docs-private
AGR_CDN_BASE=

# ---- Keamanan & server ----
AGR_SECRET_KEY=<random 64 hex — openssl rand -hex 32>
AGR_BASE_URL=https://marketplace.example.id  # URL publik untuk QR verifikasi kartu anggota
AGR_ENV=production
AGR_DEBUG=
PORT=5000
